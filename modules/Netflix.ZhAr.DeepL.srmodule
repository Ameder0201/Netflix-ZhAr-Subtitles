#!name = Netflix 中阿双语 · DeepL
#!desc = 完整简体中文＋阿拉伯语；原长分段与容量适配；DeepL；仅启用一份翻译模块。
#!version = 1.0.0 (v21-config-2)
#!arguments = SourceLanguage:AUTO,Position:zh-first,Pipeline:direct,DeepLPlan:Free,DeepLKey:REPLACE_WITH_YOUR_KEY
#!arguments-desc = SourceLanguage：AUTO／ZH-HANS／ZH-HANT／EN 等；Position：zh-first／ar-first；Pipeline：direct／pivot-zh。DeepLPlan：Free／Pro；DeepLKey：在设备编辑参数中填写自己的密钥，默认占位值不发请求。
[Script]
Netflix.ZhAr = type=http-request, pattern=^https?:\/\/[^/]+\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+, requires-body=0, timeout=35, script-path=https://raw.githubusercontent.com/Ameder0201/Netflix-ZhAr-Subtitles/v1.0.0/dist/Netflix.ZhAr.bundle.js, argument=Provider=DeepL&SourceLanguage={{{SourceLanguage}}}&Position={{{Position}}}&Pipeline={{{Pipeline}}}&DeepLPlan={{{DeepLPlan}}}&DeepLKey={{{DeepLKey}}}
[MITM]
hostname = %APPEND% *.oca.nflxvideo.net
tcp-connection = true
